# Market-data provider API keys for the server (src/server). Copy to .env and fill in.
# .env is git-ignored — never commit real keys.

# Keepa (https://keepa.com/#!api) — best for demand/BSR history.
KEEPA_API_KEY=

# Rainforest API (https://www.rainforestapi.com) — live listing/review/competitor data.
RAINFOREST_API_KEY=

# Amazon SP-API (Module 2 dashboard) — LWA credentials from your seller account.
# https://developer-docs.amazon.com/sp-api/docs/registering-your-application
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_LWA_REFRESH_TOKEN=
# amazon.ae marketplace id
SPAPI_MARKETPLACE_ID=A2VIGQ35RCS4UA

# Optional: override the API server port (default 8787).
# PORT=8787
